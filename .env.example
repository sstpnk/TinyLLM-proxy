# =============================================================================
# TinyLLM — Environment variables
# =============================================================================
# Copy this file to .env (or set the vars directly in Docker / systemd).
# DO NOT commit actual secrets to the repository.
# =============================================================================

# Comma-separated list of API keys that clients use to talk to TinyLLM.
TINYLLM_API_KEYS=sk-tinyllm-master-key

# API keys for upstream providers (the values are examples — replace them).
OPENCODE_ZEN_API_KEY=sk-zen-placeholder
OPENROUTER_API_KEY=sk-or-placeholder
ZAI_API_KEY=sk-zai-placeholder
ORCAROUTER_API_KEY=sk-orca-placeholder
DEEPSEEK2API_API_KEY=sk-deepseek2api-placeholder

# Optional generated routing layer from free-ai-model-router.
# TinyLLM keeps config.yaml as the base config and polls this file/URL safely.
# TINYLLM_DYNAMIC_CONFIG_PATH=/data/tinyllm-router-config.yaml
# TINYLLM_DYNAMIC_CONFIG_URL=https://api.github.com/repos/OWNER/free-ai-model-router/actions/artifacts/ARTIFACT_ID/zip
# TINYLLM_DYNAMIC_CONFIG_POLL_SECONDS=30
# TINYLLM_DYNAMIC_CONFIG_BEARER_TOKEN_ENV=GITHUB_TOKEN
# TINYLLM_DYNAMIC_CONFIG_ZIP_MEMBER=output/tinyllm-router-config.yaml
